# Server
HOST=0.0.0.0
PORT=8000

# LLM (Ollama محلي أو عبر شبكة)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=180

# Models Paths
VOXTRAL_MODEL_PATH=/app/models/voxtral-ar
SILMA_TTS_DIR=/app/models/silma-tts

# Audio
SAMPLE_RATE=16000
CHUNK_MS=30
VAD_AGGRESSIVENESS=2
SILENCE_TIMEOUT_MS=950
MAX_UTTERANCE_SEC=25

# Assistant
SYSTEM_PROMPT=أنت مساعد صوتي عربي ذكي، تتحدث بشكل طبيعي وواضح، موجزًا عند الحاجة ومفصلاً عند الطلب. تجيب مباشرة وبأسلوب ودود.

# Voice Cloning Ref
REF_AUDIO_PATH=/app/assets/assistant_ref.wav
REF_TEXT=ضع هنا نص الملف الصوتي المرجعي تمامًا كما هو منطوق
